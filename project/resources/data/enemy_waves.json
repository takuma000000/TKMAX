{
  "_comment": "敵WAVE全体設定。wave1, wave2, wave3 ごとに出現ルールと敵パラメータを持つ。",

  "wave1": {
    "_comment": "WAVE1: 上空から飛び込み敵が出る基本WAVE。",

    "settings": {
      "_comment": "WAVE1全体の進行設定。",
      "spawnInterval": 1.5,
      "maxSimultaneous": 2,
      "defeatTarget": 10
    },

    "spawn": {
      "_comment": "敵を出す基準位置。Xだけランダム、Y/Zは固定基準。",
