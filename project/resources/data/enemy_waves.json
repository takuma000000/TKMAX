        "sineAmp": 4.0,
        "sineFreq": 1.4,
        "phaseStep": 0.6,
        "behavior": "SineX"
      },

      "line": {
        "_comment": "横一列編隊用。まっすぐ進んで stopZ で止まる。",
        "model": "jerryfish.obj",
        "hp": 2,
        "vel": {
          "_comment": "基本移動速度。",
          "x": 0.0,
          "y": 0.0,
          "z": -0.32
        },
        "stopZ": 52.0,
        "behavior": "StraightStop"
      },

      "column": {
        "_comment": "縦列編隊用。斜め気味に進みつつ stopZ を基準に動く。",
        "model": "jerryfish.obj",
        "hp": 1,
        "vel": {
          "_comment": "基本移動速度。",
          "x": -0.20,
          "y": 0.0,
          "z": -0.75
        },
        "stopZ": -50.0,
        "behavior": "StraightStop"
      }
    }
  },

  "wave3": {
    "_comment": "WAVE3: 中ボス戦。左右に中ボスを置き、コア出現や怒り時間も管理する。",

