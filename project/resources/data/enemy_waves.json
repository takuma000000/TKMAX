      "baseZ": 100.0,
      "randXMin": -20.0,
      "randXMax": 20.0
    },

    "enemyParams": {
      "_comment": "WAVE1敵1体ごとの挙動パラメータ。",
      "model": "jerryfish.obj",
      "hp": 1,
      "startY": 20.0,
      "targetForwardZ": 3.0,
      "apexY": 30.0,
      "pounceTime": 1.6,
      "behavior": "PounceFromAbove"
    }
  },

  "wave2": {
