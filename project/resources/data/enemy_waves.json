    "enemyParams": {
      "_comment": "編隊ごとに使う敵パラメータ。pattern名と対応している。",

      "triangle": {
        "_comment": "三角編隊用。左右に揺れながら前進する。",
        "model": "jerryfish.obj",
        "hp": 3,
        "vel": {
          "_comment": "基本移動速度。",
