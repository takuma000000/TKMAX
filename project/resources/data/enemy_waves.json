        "pattern": "Line",
        "lineCount": 4,
        "lineY": 4.5,
        "lineZ": 90.0,
        "lineXStart": -12.0,
        "lineXStep": 8.0
      },
      {
        "_comment": "サブWAVE3: 縦列編隊。",
        "pattern": "Column",
        "colCount": 3,
        "colX": 18.0,
        "colZStart": 100.0,
        "colZStep": 10.0,
        "colYStart": 5.0,
        "colYStep": 0.0
